{
  "id": "netease-cloud-music",
  "name": "NetEase Cloud Music",
  "version": "0.1.2",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "music.163.com",
      "interfacepc.music.163.com"
    ]
  },
  "settings": [
    {
      "key": "quality",
      "label": "Quality Override",
      "help": "Leave empty to follow the player. Options: standard / higher / exhigh / lossless / hires. Your account must have access to the requested quality."
    },
    {
      "key": "loginMethod",
      "label": "Sign-in Method",
      "help": "Leave empty or use qr for QR sign-in; use web for website sign-in. Sessions are stored in the host's plugin data files, not the system keychain."
    },
    {
      "key": "userQuery",
      "label": "People Search Query",
      "help": "Used in Explore > Find People. Leave empty to reuse your last music search. Refresh the page after changing this setting."
    }
  ],
  "navigation": [
    {
      "title": "Discover Music",
      "builtin": "home",
      "icon": "home"
    },
    {
      "title": "Daily Recommendations",
      "page": "daily",
      "icon": "calendar"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "Liked Songs",
      "builtin": "liked",
      "icon": "heart"
    },
    {
      "title": "Saved Albums",
      "builtin": "savedAlbums",
      "icon": "album"
    },
    {
      "title": "Followed Artists",
      "page": "following",
      "icon": "artist"
    },
    {
      "title": "Personal FM / Heart Mode",
      "builtin": "stations",
      "icon": "radio"
    },
    {
      "title": "Discover Podcasts",
      "page": "podcasts",
      "icon": "podcast"
    },
    {
      "title": "Subscribed Podcasts",
      "builtin": "shows",
      "icon": "podcast"
    },
    {
      "title": "Recently Played",
      "page": "recent",
      "icon": "note"
    },
    {
      "title": "Explore",
      "page": "explore",
      "icon": "search"
    }
  ]
}
