{
  "name": "mygo-music-netease-cloud-music",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:plugin": "node --import tsx --test tests/*.test.ts",
    "test:tooling": "node --import tsx --test tests/tooling/*.test.ts",
    "test": "pnpm build && pnpm test:plugin && pnpm test:tooling",
    "package": "tsx scripts/package.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm package",
    "version:set": "tsx scripts/version.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@noble/ciphers": "2.4.0"
  }
}
